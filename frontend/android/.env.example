# ============================================
# HiDocs Android/Flutter Environment Config
# ============================================
# Copy file ini ke .env dan sesuaikan dengan environment Anda

# API Backend Base URL (REQUIRED)
API_BASE_URL=http://localhost:8080/api/v1

# Alternatif untuk berbagai environment:
# ----------------------------------------
# Development (Web/Desktop): 
#   API_BASE_URL=http://localhost:8080/api/v1
#
# Android Emulator:
#   API_BASE_URL=http://10.0.2.2:8080/api/v1
#
# iOS Simulator:
#   API_BASE_URL=http://127.0.0.1:8080/api/v1
#
# Physical Device (ganti dengan IP LAN komputer Anda):
#   API_BASE_URL=http://192.168.1.100:8080/api/v1
#
# Production/Staging (Ngrok atau domain):
#   API_BASE_URL=https://your-domain.ngrok-free.dev/api/v1
#   API_BASE_URL=https://api.hidocs.id/api/v1
